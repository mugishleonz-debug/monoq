---
import { formatNewsDate, getAllNews } from '../../lib/microcms';
import { ClientRouter } from 'astro:transitions';
import MonoQLogo from '../../components/MonoQLogo.astro';

const news = await getAllNews();
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>お知らせ | MonoQ</title>
    <meta name="description" content="モノク株式会社のお知らせ、リリース、レポート、掲載情報、技術評価に関する考察を掲載しています。" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Serif+JP:wght@400;500;600&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.2/anime.min.js"></script>
    <ClientRouter fallback="animate" />
    <style>
      @keyframes pageIn{from{opacity:.001;transform:translateY(18px);filter:blur(8px)}to{opacity:1;transform:translateY(0);filter:blur(0)}}
      @keyframes pageOut{from{opacity:1;transform:translateY(0);filter:blur(0)}to{opacity:.001;transform:translateY(-12px);filter:blur(6px)}}
      ::view-transition-old(root){animation:pageOut .32s cubic-bezier(.4,0,.2,1) both}
      ::view-transition-new(root){animation:pageIn .46s cubic-bezier(.2,.7,.2,1) both}
      ::view-transition-group(*),::view-transition-old(*),::view-transition-new(*){animation-duration:.46s}
      @media (prefers-reduced-motion:reduce){::view-transition-old(root),::view-transition-new(root){animation:none}}
      :root{--bg:#f4f1ea;--fg:#171814;--muted:#6f7069;--line:rgba(23,24,20,.14);--accent:#ff6b00;--sans:"Zen Kaku Gothic New",sans-serif;--serif:"Noto Serif JP",serif;--mono:"IBM Plex Mono",monospace}
      *{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--sans);letter-spacing:.02em} a{color:inherit;text-decoration:none}
      .wrap{width:min(1120px,calc(100% - 64px));margin:0 auto}.nav{height:92px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}
      .brand{display:inline-flex;align-items:center;--monoq-logo-width:162px}.back{font-family:var(--mono);font-size:13px;border:1px solid var(--fg);padding:14px 22px;border-radius:4px}
      .hero{padding:92px 0 72px}.eyebrow{font-family:var(--mono);font-size:12px;color:var(--accent);letter-spacing:.18em;margin-bottom:18px}.title{font-family:var(--serif);font-size:clamp(46px,8vw,96px);font-weight:500;line-height:1;margin:0}.lead{margin:28px 0 0;color:var(--muted);line-height:2;max-width:620px}
      .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:48px 32px;padding-bottom:120px}.card{display:flex;flex-direction:column}.thumb{position:relative;aspect-ratio:16/10;overflow:hidden;border-radius:3px;background:#e8e2d7;margin-bottom:22px}.thumb img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .8s cubic-bezier(.2,.7,.2,1)}.card:hover img{transform:scale(1.06)}
      .cat{position:absolute;top:12px;left:12px;background:#10110f;color:#fff;font-family:var(--mono);font-size:10px;letter-spacing:.14em;padding:7px 10px;border-radius:2px}.meta{display:flex;gap:12px;align-items:center;font-family:var(--mono);font-size:11px;color:var(--muted);margin-bottom:12px}.dot{width:3px;height:3px;border-radius:50%;background:var(--line)}.card h2{font-size:20px;line-height:1.55;margin:0 0 14px}.card p{font-size:14px;line-height:1.9;color:var(--muted);margin:0}
      @media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:640px){.wrap{width:min(100% - 40px,1120px)}.nav{height:76px}.grid{grid-template-columns:1fr}.hero{padding:64px 0 56px}}
    </style>
  </head>
  <body>
    <div class="wrap">
      <nav class="nav">
        <a href="/" class="brand" aria-label="MonoQ トップへ"><MonoQLogo /></a>
        <a href="/#news" class="back">Back</a>
      </nav>
      <main>
        <header class="hero">
          <div class="eyebrow">05 — NEWS</div>
          <h1 class="title">お知らせ</h1>
          <p class="lead">MonoQのリリース、レポート、掲載情報、技術評価に関する考察をまとめています。</p>
        </header>
        <div class="grid">
          {news.map((item) => (
            <article class="card">
              <a href={`/news/${item.id}/`}>
                <div class="thumb" transition:name={`news-thumb-${item.id}`}>
                  <img src={item.eyecatch?.url} alt="" loading="lazy" />
                  <span class="cat">{item.category}</span>
                </div>
                <div class="meta">
                  <time datetime={item.publishedAt}>{formatNewsDate(item.publishedAt)}</time>
                  <span class="dot"></span>
                  <span>{item.tag}</span>
                </div>
                <h2 transition:name={`news-title-${item.id}`}>{item.title}</h2>
                <p>{item.excerpt}</p>
              </a>
            </article>
          ))}
        </div>
      </main>
    </div>
  </body>
</html>
