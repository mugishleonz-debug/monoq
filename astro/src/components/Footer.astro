---
import MonoQLogo from './MonoQLogo.astro';
---
<footer class="foot">
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <div class="foot-logo">
          <MonoQLogo class="is-light footer-monoq-logo" />
        </div>
        <p>エンジニアの実力を、正しく評価する。<br/>モノク株式会社 &nbsp;/ &nbsp;MonoQ, Inc.</p>
      </div>
      <div class="foot-cols">
        <div>
          <h5>Business</h5>
          <ul>
            <li><a href="#business">システムエンジニアリングサービス</a></li>
            <li><a href="#business">IT人材評価SaaS</a></li>
          </ul>
        </div>
        <div>
          <h5>Company</h5>
          <ul>
            <li><a href="#company">会社概要</a></li>
            <li><a href="#message">代表挨拶</a></li>
          </ul>
        </div>
        <div>
          <h5>News</h5>
          <ul>
            <li><a href="#news">最新のお知らせ</a></li>
            <li><a href="#news">プロダクト</a></li>
            <li><a href="#news">掲載情報</a></li>
          </ul>
        </div>
        <div>
          <h5>Contact</h5>
          <ul>
            <li><a href="#faq">FAQ</a></li>
            <li><a href="#contact">お問い合わせ</a></li>
            <li><a href="/privacy/">プライバシーポリシー</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="foot-bot">
      <div class="copy">© 2026 MonoQ, Inc. All rights reserved.</div>
      <div class="stat">monoq.jp — contact ready</div>
    </div>
  </div>
</footer>
