    <div class="hero-main">
      <div class="tm-outer">
        <div class="tm">
          <div class="tmbar">
            <div class="ttraf">
              <div class="ttl ttl-r"></div>
              <div class="ttl ttl-y"></div>
              <div class="ttl ttl-g"></div>
            </div>
            <div class="tmtitle">monoq-eval.sh — zsh — 142×38</div>
            <div class="tconn"><div class="cdot"></div>CONNECTED</div>
          </div>

          <div class="cblock">
            <div class="cl"><span class="ln">1</span><span class="sp">│</span><span class="c0">#!/usr/bin/env bash</span></div>
            <div class="cl"><span class="ln">2</span><span class="sp">│</span><span class="c0"># monoq-skill.sh &nbsp;v1.0</span></div>
            <div class="cl"><span class="ln">3</span><span class="sp">│</span></div>
            <div class="cl"><span class="ln">4</span><span class="sp">│</span><span class="cv">TITLE</span><span class="cd">=</span><span class="cs">"エンジニアの実力を、正しく評価する。"</span></div>
            <div class="cl"><span class="ln">5</span><span class="sp">│</span><span class="cv">DESC</span><span class="cd">=</span><span class="cs">"スキルを客観的に可視化する。"</span></div>
            <div class="cl"><span class="ln">6</span><span class="sp">│</span></div>
            <div class="cl"><span class="ln">7</span><span class="sp">│</span><span class="cf">eval_run</span><span class="cd">() {</span></div>
            <div class="cl"><span class="ln">8</span><span class="sp">│</span>&nbsp;&nbsp;<span class="ck">bias</span> <span class="cd">--remove &&</span> <span class="ck">skill_matrix</span> <span class="cd">--init</span></div>
            <div class="cl"><span class="ln">9</span><span class="sp">│</span>&nbsp;&nbsp;<span class="ck">printf</span> <span class="cd">'%s\n'</span> <span class="cx">"$TITLE"</span> <span class="cx">"$DESC"</span></div>
            <div class="cl"><span class="ln">10</span><span class="sp">│</span><span class="cd">} &&</span> <span class="cf">eval_run</span> <span class="ch"># --reproducible</span></div>
          </div>

          <div class="runsec">
            <div class="rcmd" id="rcmd"><span class="cbg"></span></div>
            <div class="rhead" id="rhead"></div>
            <div class="rsub" id="rsub"></div>
          </div>
        </div>
      </div>

      <div class="hero-cta-row">
        <div class="bmsg" id="bmsg"></div>
